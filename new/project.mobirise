    "EmailDeliverability.html": {
      "settings": {
        "title": "Email Deliverability And Outreach",
        "meta_descr": "With over 7 years of dedicated expertise, I've honed digital marketing strategies to drive exceptional results. From captivating campaigns to high-impact ads, my focus on enhancing ROI, CTR, and LTV resonates across diverse platforms. Let me orchestrate your brand's success with unique automation and resonating email campaigns.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "1"
      },
      "components": [
        {
          "alias": false,
